N  * @}
N  */
N
N/** @defgroup ADC_LL_EC_COMMON_PATH_INTERNAL  ADC common - Measurement path to internal channels
N  * @{
N  */
N/* Note: Other measurement paths to internal channels may be available        */
N/*       (connections to other peripherals).                                  */
N/*       If they are not listed below, they do not require any specific       */
N/*       path enable. In this case, Access to measurement path is done        */
N/*       only by selecting the corresponding ADC internal channel.            */
N#define LL_ADC_PATH_INTERNAL_NONE          0x00000000UL            /*!< ADC measurement paths all disabled */
N#define LL_ADC_PATH_INTERNAL_VREFINT       (ADC_CCR_TSVREFE)      /*!< ADC measurement path to internal channel VrefInt */
N#define LL_ADC_PATH_INTERNAL_TEMPSENSOR    (ADC_CCR_TSVREFE)      /*!< ADC measurement path to internal channel temperature sensor */
N#define LL_ADC_PATH_INTERNAL_VBAT          (ADC_CCR_VBATE)        /*!< ADC measurement path to internal channel Vbat */
N/**
N  * @}
N  */
N
