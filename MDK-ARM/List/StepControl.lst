Nuint8_t Find_Wavelength_init_pos(void)
N{
N	int32_t start_pos, cur_pos;
N	uint8_t stat=0;
N	
N	TMC5130_SetMaxSpeed(TMC5130_HOMING_MOVE_SPEED); //SPI send: 0xA700030D40; // VMAX = 200 000
X	TMC5130_SetMaxSpeed(500); 
N
N	start_pos = TMC5130_GetActualPosition();
N	printf("ÆðÊ¼Î»ÖÃ: %d\r\n", start_pos);
N	
N	/* ÕýÏòÔË¶¯ */
N	printf("·´ÏòÔË¶¯...ÕÒÁãÎ»\r\n");
N	TMC5130_MoveToPosition(start_pos - 256*800);
N		
N	while(1)
N	{
N		cur_pos = TMC5130_ReadRegister_stat(TMC5130_XACTUAL,&stat);
X		cur_pos = TMC5130_ReadRegister_stat(0x21,&stat);
N//		printf("pos= %10d stat= 0x%02x\r\n",cur_pos,stat);
N		if(stat & 0x40)//µ½´ï0Î»
N		{
N				printf("µ½´ï0Î»ÖÃ--0\r\n");
N				TMC5130_SetMaxSpeed(150); //SPI send: 0xA700030D40; // VMAX = 200 000
N				while(1)
N				{
N					TMC5130_MoveToPosition(cur_pos + 1);
N					osDelay(pdMS_TO_TICKS(200));
X					osDelay(( ( TickType_t ) ( ( ( TickType_t ) ( 200 ) * ( TickType_t ) ((TickType_t)1000) ) / ( TickType_t ) 1000 ) ));
N					cur_pos = TMC5130_ReadRegister_stat(TMC5130_XACTUAL,&stat);
X					cur_pos = TMC5130_ReadRegister_stat(0x21,&stat);
N					printf("pos= %10d stat= 0x%02x\r\n",cur_pos,stat);
N					if(stat & 0x40)
N					{}
N					else
N					{
N						break;
N					}												
N				}
N				printf("µ½´ï0Î»ÖÃ--1\r\n");
N			
N				TMC5130_Set_Zero_Pos();
N				printf("Ñ°ÕÒ²¨³¤³õÊ¼Î»ÖÃÍê³É\r\n");
N				CurWaveLen = 0;
N				StepperControlStat[WaveLenStepper].Cnt = 0;
X				StepperControlStat[0].Cnt = 0;
N				return 0X00;
N		}
N		else if(stat & 0x20)//Èç¹û position_reached£¬¾ÍËµÃ÷²¨³¤µç»úÓÐÎÊÌâ¡£ÒòÎª¿Ï¶¨×ª²»µ½1È¦
N		{
N				TMC5130_Stop();
N				printf("ÎÞ·¨ÕÒµ½³õÊ¼Î»ÖÃ\r\n");
N				return 0X01;
N		}
N		osDelay(pdMS_TO_TICKS(500));
X		osDelay(( ( TickType_t ) ( ( ( TickType_t ) ( 500 ) * ( TickType_t ) ((TickType_t)1000) ) / ( TickType_t ) 1000 ) ));
N
N	}		
N
N}
N
N
N/**
N * @brief °´Ö¸¶¨²½Êý¿ØÖÆÖ¸¶¨²½½øµç»úÒÆ¶¯¡£
N * @param StepIndex ²½½øµç»úË÷Òý¡£
N * @param dir ÔË¶¯·½Ïò²ÎÊý¡£
N * @param n ÐèÒªÒÆ¶¯µÄ²½Êý£¬¿ÉÎªÕýÊý»ò¸ºÊý¡£
N * @retval ÎÞ¡£
N * @note µ±Ç°ÊµÏÖÖ»´¦Àí²¨³¤²½½øµç»ú£¬²¢ÒÀ¾ÝÊµ¼ÊÎ»ÖÃÏÂ·¢Ä¿±êÎ»ÖÃ¡£
N */
Nvoid MoveNStep(uint8_t StepIndex, uint8_t dir, int32_t n)
N{
N	int32_t start_pos;
N	int32_t stepDelta;
N	int wl;
N
N	stepDelta = ((dir == BACKWARD) && (n > 0)) ? -n : n;
X	stepDelta = ((dir == 1) && (n > 0)) ? -n : n;
N	switch(StepIndex)
N	{
N		case WaveLenStepper:
X		case 0:
N			
N			/* »ñÈ¡µ±Ç°Î»ÖÃ */
N			start_pos = TMC5130_GetActualPosition();
N			wl = PositionToWavelength(start_pos);
N			printf("ÆðÊ¼Î»ÖÃ:pos=%5d,calc_wl=%5d\r\n",start_pos,wl);
N			
N			/* ÕýÏòÔË¶¯ */
N			TMC5130_MoveToPosition(start_pos + stepDelta);
N			wl = PositionToWavelength(start_pos + stepDelta);
N			printf("Ä¿±êÎ»ÖÃ:pos=%5d,calc_wl=%5d\r\n",start_pos + stepDelta,wl);
N		
N			break;
N		default:
N			printf("other stepper\r\n");
N		break;
N	}
N
N}							  
N
N
N
N
N/**
N * @brief Í¨¹ý²¨³¤µç»úÃüÁî¶ÓÁÐÌá½»Ä¿±ê²¨³¤²¢µÈ´ýÒÆ¶¯Íê³É¡£
N * @param DesWaveLen Ä¿±ê²¨³¤Öµ£¬µ¥Î»Óë²¨³¤»»Ëãº¯ÊýÒ»ÖÂ¡£
N * @retval ÎÞ¡£
N * @note ¶ÓÁÐ»òÊÂ¼þ×éÎ´³õÊ¼»¯¡¢ÃüÁîÌá½»Ê§°ÜÊ±¼ÇÂ¼´íÎó²¢·µ»Ø¡£
N */
Nvoid MoveToWaveLen(int32_t DesWaveLen)
N{
N	StepperCommandMessage_t message;
N	EventBits_t eventBits;
N
N	if ((g_WaveLengthStepperQueue == NULL) || (MyOsFlag == NULL))
X	if ((g_WaveLengthStepperQueue == 0) || (MyOsFlag == 0))
N	{
N		printf("Wavelength stepper queue or event group is not ready\r\n");
N		return;
N	}
N
N	message.command = STEPPER_CMD_MOVE_TO_WAVELENGTH;
X	message.command = 1U;
N	message.value.targetWavelength = DesWaveLen;
N	(void)xEventGroupClearBits(MyOsFlag, TASK_WAVE_LENGTH_FINISH_FLAG);
X	(void)xEventGroupClearBits(MyOsFlag, (1UL << 7U));
N
N	if (xQueueSend(g_WaveLengthStepperQueue, &message, portMAX_DELAY) != pdPASS)
X	if (xQueueGenericSend( ( g_WaveLengthStepperQueue ), ( &message ), ( ( TickType_t ) 0xffffffffUL ), ( ( BaseType_t ) 0 ) ) != ( ( ( BaseType_t ) 1 ) ))
N	{
N		printf("Failed to send wavelength stepper command\r\n");
N		return;
N	}
N
N	eventBits = xEventGroupWaitBits(MyOsFlag,
N	                                TASK_WAVE_LENGTH_FINISH_FLAG,
X	                                (1UL << 7U),
N	                                pdTRUE,
X	                                ( ( BaseType_t ) 1 ),
N	                                pdTRUE,
X	                                ( ( BaseType_t ) 1 ),
N	                                portMAX_DELAY);
X	                                ( TickType_t ) 0xffffffffUL);
N	if ((eventBits & TASK_WAVE_LENGTH_FINISH_FLAG) == 0U)
X	if ((eventBits & (1UL << 7U)) == 0U)
N	{
N		printf("Wavelength stepper completion was not signaled\r\n");
N	}
N}
N
Nvoid MoveToWL_With_Speed(int32_t DesWL,int32_t speed)
N{
N  int32_t tmpDesWavePos;
N
N
N	TMC5130_SetMaxSpeed(speed); //SPI send: 0xA700030D40; // VMAX = 200 000
N
N	tmpDesWavePos = WavelengthToPosition(DesWL);
N	
N	
N	TMC5130_MoveToPosition(tmpDesWavePos);
N	int32_t wl = PositionToWavelength(tmpDesWavePos);
N//	printf("Ä¿±êÎ»ÖÃ:pos=%5d,calc_wl=%5d\r\n",tmpDesWavePos,wl);
N
N	while(TMC5130_GetMotionStatus() != STATUS_TARGET_REACHED)
X	while(TMC5130_GetMotionStatus() != 4)
N	{
N		_delay_us(100);
N	}
N	// OSSemPend(StepReachSem[WaveLenStepper],0,&err);
N	CurWaveLen = DesWL;
N	StepperControlStat[WaveLenStepper].Cnt = tmpDesWavePos;
X	StepperControlStat[0].Cnt = tmpDesWavePos;
N
N}
N
N
N
Nvoid MoveToWL_WithOut_Speed(int32_t DesWL)
N{
N  int32_t tmpDesWavePos;
N
N	tmpDesWavePos = WavelengthToPosition(DesWL);
N	
N	
N	TMC5130_MoveToPosition(tmpDesWavePos);
N	int32_t wl = PositionToWavelength(tmpDesWavePos);
N//	printf("Ä¿±êÎ»ÖÃ:pos=%5d,calc_wl=%5d\r\n",tmpDesWavePos,wl);
N	
N	while(1)
N	{
N		uint32_t actual_pos = TMC5130_ReadRegister(TMC5130_XACTUAL);
X		uint32_t actual_pos = TMC5130_ReadRegister(0x21);
N		if(actual_pos == tmpDesWavePos)
N		{
N			break;
N		}
N		else
N		{
N			_delay_us(10);
N		}
N	}
N
N	CurWaveLen = DesWL;
N	StepperControlStat[WaveLenStepper].Cnt = tmpDesWavePos;
X	StepperControlStat[0].Cnt = tmpDesWavePos;
N
N}
