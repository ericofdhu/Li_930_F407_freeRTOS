X#define TIM_CHANNEL_N_STATE_SET_ALL(__HANDLE__,  __CHANNEL_STATE__)  do {    (__HANDLE__)->ChannelNState[0] =     (__CHANNEL_STATE__);      (__HANDLE__)->ChannelNState[1] =     (__CHANNEL_STATE__);      (__HANDLE__)->ChannelNState[2] =     (__CHANNEL_STATE__);      (__HANDLE__)->ChannelNState[3] =     (__CHANNEL_STATE__);    } while(0)
