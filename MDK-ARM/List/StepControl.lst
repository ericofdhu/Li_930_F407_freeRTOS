N#else                            // define the object
N#define osMessageQDef(name, queue_sz, type) \
Nstatic StaticQueue_t os_mq_cb_##name; \
Nstatic uint32_t os_mq_data_##name[(queue_sz) * sizeof(type)]; \
Nconst osMessageQDef_t os_messageQ_def_##name = \
N{ (queue_sz), \
N  { NULL, 0U, (&os_mq_cb_##name), sizeof(StaticQueue_t), \
N              (&os_mq_data_##name), sizeof(os_mq_data_##name) } }
X#define osMessageQDef(name, queue_sz, type) static StaticQueue_t os_mq_cb_##name; static uint32_t os_mq_data_##name[(queue_sz) * sizeof(type)]; const osMessageQDef_t os_messageQ_def_##name = { (queue_sz),   { NULL, 0U, (&os_mq_cb_##name), sizeof(StaticQueue_t),               (&os_mq_data_##name), sizeof(os_mq_data_##name) } }
N#endif
N 
N/// \brief Access a Message Queue Definition.
N/// \param         name          name of the queue
N#define osMessageQ(name) \
N&os_messageQ_def_##name
X#define osMessageQ(name) &os_messageQ_def_##name
N 
N/// Create and Initialize a Message Queue object.
N/// \param[in]     queue_def     message queue definition referenced with \ref osMessageQ.
N/// \param[in]     thread_id     thread ID (obtained by \ref osThreadCreate or \ref osThreadGetId) or NULL.
N/// \return message queue ID for reference by other functions or NULL in case of error.
NosMessageQId osMessageCreate (const osMessageQDef_t *queue_def, osThreadId thread_id);
XosMessageQId osMessageCreate (const osMessageQDef_t *queue_def, osThreadId_t thread_id);
N 
N/// Put a Message to a Queue.
N/// \param[in]     queue_id      message queue ID obtained with \ref osMessageCreate.
N/// \param[in]     info          message information.
N/// \param[in]     millisec      \ref CMSIS_RTOS_TimeOutValue or 0 in case of no time-out.
N/// \return status code that indicates the execution status of the function.
NosStatus osMessagePut (osMessageQId queue_id, uint32_t info, uint32_t millisec);
N 
N/// Get a Message from a Queue or timeout if Queue is empty.
N/// \param[in]     queue_id      message queue ID obtained with \ref osMessageCreate.
N/// \param[in]     millisec      \ref CMSIS_RTOS_TimeOutValue or 0 in case of no time-out.
N/// \return event information that includes status code.
Nos_InRegs osEvent osMessageGet (osMessageQId queue_id, uint32_t millisec);
X__value_in_regs osEvent osMessageGet (osMessageQId queue_id, uint32_t millisec);
N 
N#endif  // Message Queue available
N 
N 
N//  ==== Mail Queue Management Functions ====
N 
N#if (defined(osFeature_MailQ) && (osFeature_MailQ != 0))  // Mail Queue available
X#if (1L && (0 != 0))  
S 
S/// \brief Create a Mail Queue Definition.
S/// \param         name          name of the queue.
S/// \param         queue_sz      maximum number of mails in the queue.
S/// \param         type          data type of a single mail element.
S#if defined (osObjectsExternal)  // object is external
S#define osMailQDef(name, queue_sz, type) \
Sextern const osMailQDef_t os_mailQ_def_##name
X#define osMailQDef(name, queue_sz, type) extern const osMailQDef_t os_mailQ_def_##name
S#else                            // define the object
S#define osMailQDef(name, queue_sz, type) \
Sconst osMailQDef_t os_mailQ_def_##name = \
S{ (queue_sz), sizeof(type), NULL }
X#define osMailQDef(name, queue_sz, type) const osMailQDef_t os_mailQ_def_##name = { (queue_sz), sizeof(type), NULL }
S#endif
S 
S/// \brief Access a Mail Queue Definition.
S/// \param         name          name of the queue
S#define osMailQ(name) \
S&os_mailQ_def_##name
X#define osMailQ(name) &os_mailQ_def_##name
S 
S/// Create and Initialize a Mail Queue object.
S/// \param[in]     queue_def     mail queue definition referenced with \ref osMailQ.
S/// \param[in]     thread_id     thread ID (obtained by \ref osThreadCreate or \ref osThreadGetId) or NULL.
S/// \return mail queue ID for reference by other functions or NULL in case of error.
SosMailQId osMailCreate (const osMailQDef_t *queue_def, osThreadId thread_id);
S 
S/// Allocate a memory block for mail from a mail memory pool.
S/// \param[in]     queue_id      mail queue ID obtained with \ref osMailCreate.
S/// \param[in]     millisec      \ref CMSIS_RTOS_TimeOutValue or 0 in case of no time-out
S/// \return pointer to memory block that can be filled with mail or NULL in case of error.
Svoid *osMailAlloc (osMailQId queue_id, uint32_t millisec);
S 
S/// Allocate a memory block for mail from a mail memory pool and set memory block to zero.
S/// \param[in]     queue_id      mail queue ID obtained with \ref osMailCreate.
S/// \param[in]     millisec      \ref CMSIS_RTOS_TimeOutValue or 0 in case of no time-out
S/// \return pointer to memory block that can be filled with mail or NULL in case of error.
Svoid *osMailCAlloc (osMailQId queue_id, uint32_t millisec);
S 
S/// Put a Mail into a Queue.
S/// \param[in]     queue_id      mail queue ID obtained with \ref osMailCreate.
S/// \param[in]     mail          pointer to memory with mail to put into a queue.
S/// \return status code that indicates the execution status of the function.
SosStatus osMailPut (osMailQId queue_id, const void *mail);
S 
S/// Get a Mail from a Queue or timeout if Queue is empty.
S/// \param[in]     queue_id      mail queue ID obtained with \ref osMailCreate.
S/// \param[in]     millisec      \ref CMSIS_RTOS_TimeOutValue or 0 in case of no time-out.
S/// \return event information that includes status code.
Sos_InRegs osEvent osMailGet (osMailQId queue_id, uint32_t millisec);
S 
S/// Free a memory block by returning it to a mail memory pool.
S/// \param[in]     queue_id      mail queue ID obtained with \ref osMailCreate.
S/// \param[in]     mail          pointer to memory block that was obtained with \ref osMailGet.
S/// \return status code that indicates the execution status of the function.
SosStatus osMailFree (osMailQId queue_id, void *mail);
S 
N#endif  // Mail Queue available
N 
N 
N#ifdef  __cplusplus
S}
N#endif
