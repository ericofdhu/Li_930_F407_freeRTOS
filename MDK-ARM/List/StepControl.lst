N  * @param  ADCx ADC instance
N  * @param  Rank This parameter can be one of the following values:
N  *         @arg @ref LL_ADC_INJ_RANK_1
N  *         @arg @ref LL_ADC_INJ_RANK_2
N  *         @arg @ref LL_ADC_INJ_RANK_3
N  *         @arg @ref LL_ADC_INJ_RANK_4
N  * @retval Value between Min_Data=0x000 and Max_Data=0xFFF
N  */
N__STATIC_INLINE uint32_t LL_ADC_INJ_GetOffset(const ADC_TypeDef *ADCx, uint32_t Rank)
Xstatic __inline uint32_t LL_ADC_INJ_GetOffset(const ADC_TypeDef *ADCx, uint32_t Rank)
N{
N  __IO uint32_t const *preg = __ADC_PTR_REG_OFFSET(ADCx->JOFR1, __ADC_MASK_SHIFT(Rank, ADC_INJ_JOFRX_REGOFFSET_MASK));
X  volatile uint32_t const *preg = ((volatile uint32_t *)((uint32_t) ((uint32_t)(&(ADCx->JOFR1)) + (((((Rank) & ((0x00000000UL | 0x00001000UL | 0x00002000UL | 0x00003000UL))) >> (__clz(__rbit(((0x00000000UL | 0x00001000UL | 0x00002000UL | 0x00003000UL))))))) << 2UL))));
N
N  return (uint32_t)(READ_BIT(*preg,
N                             ADC_JOFR1_JOFFSET1)
X  return (uint32_t)(((*preg) & ((0xFFFUL << (0U))))
N                   );
