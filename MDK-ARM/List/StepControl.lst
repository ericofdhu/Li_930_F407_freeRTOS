N                                         |(__STM32F4xx_CMSIS_VERSION_SUB1 << 16)\
N                                         |(__STM32F4xx_CMSIS_VERSION_SUB2 << 8 )\
N                                         |(__STM32F4xx_CMSIS_VERSION_RC))
