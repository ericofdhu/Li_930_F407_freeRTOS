N  *         @arg @ref LL_ADC_AWD_CHANNEL_9_INJ
N  *         @arg @ref LL_ADC_AWD_CHANNEL_9_REG_INJ
N  *         @arg @ref LL_ADC_AWD_CHANNEL_10_REG
N  *         @arg @ref LL_ADC_AWD_CHANNEL_10_INJ
N  *         @arg @ref LL_ADC_AWD_CHANNEL_10_REG_INJ
