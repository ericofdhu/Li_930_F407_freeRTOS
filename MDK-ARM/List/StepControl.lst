L 8 "../Core/Inc/system_runtime.h" 2
Ntypedef struct
N{
N  volatile uint8_t En;
N  volatile uint32_t cnt;
N} BeepCtrl_t;
N
Nextern volatile BeepCtrl_t Beep;
N
Ntypedef struct _SYS_FLAG
N{
N	uint32_t MoveFlag				:1;
N	uint32_t MoveDirFlag			:1;
N	uint32_t ReadFreqFlag 		:1;
N	uint32_t RunWaveScanFlag		:1;
N	uint32_t RunBaseScanFlag		:1;
N	uint32_t EmergercyStopFlag    :1;
N	uint32_t OnePointMethodGetKFlag	:1;
N	uint32_t MultiPointMehtodGetBiaoDing	:1;
N	uint32_t RunTimeScanFlag			:1;
N	uint32_t ZeroSetStep			:3;
