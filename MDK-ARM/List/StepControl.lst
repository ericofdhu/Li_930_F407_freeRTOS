N                           ((FREQ) == HAL_TICK_FREQ_100HZ) || \
N                           ((FREQ) == HAL_TICK_FREQ_1KHZ))
X#define IS_TICKFREQ(FREQ) (((FREQ) == HAL_TICK_FREQ_10HZ)  ||                            ((FREQ) == HAL_TICK_FREQ_100HZ) ||                            ((FREQ) == HAL_TICK_FREQ_1KHZ))
