S                                                       SYSCFG->MEMRMP |= (SYSCFG_MEMRMP_MEM_MODE_2);\
S                                                      }while(0);
X#define __HAL_SYSCFG_REMAPMEMORY_FMC_SDRAM()       do {SYSCFG->MEMRMP &= ~(SYSCFG_MEMRMP_MEM_MODE);                                                       SYSCFG->MEMRMP |= (SYSCFG_MEMRMP_MEM_MODE_2);                                                      }while(0);
