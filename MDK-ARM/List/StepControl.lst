N#define GPIO_AFRH_AFRH3_1                GPIO_AFRH_AFSEL11_1
N#define GPIO_AFRH_AFRH3_2                GPIO_AFRH_AFSEL11_2
N#define GPIO_AFRH_AFRH3_3                GPIO_AFRH_AFSEL11_3
