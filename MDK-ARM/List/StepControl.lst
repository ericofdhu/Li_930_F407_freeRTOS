X#if (0U == 1U)
SHAL_StatusTypeDef HAL_SPI_RegisterCallback(SPI_HandleTypeDef *hspi, HAL_SPI_CallbackIDTypeDef CallbackID,
S                                           pSPI_CallbackTypeDef pCallback);
SHAL_StatusTypeDef HAL_SPI_UnRegisterCallback(SPI_HandleTypeDef *hspi, HAL_SPI_CallbackIDTypeDef CallbackID);
N#endif /* USE_HAL_SPI_REGISTER_CALLBACKS */
