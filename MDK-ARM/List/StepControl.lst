N  * @param  __ADCx__ ADC instance
N  * @retval ADC common register instance
N  */
N#if defined(ADC1) && defined(ADC2) && defined(ADC3)
X#if 1L && 1L && 1L
N#define __LL_ADC_COMMON_INSTANCE(__ADCx__)                                     \
N  (ADC123_COMMON)
