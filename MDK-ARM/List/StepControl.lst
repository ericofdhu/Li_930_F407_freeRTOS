N  * @rmtoll CR2      DMA            LL_ADC_REG_GetDMATransfer\n
N  *         CR2      DDS            LL_ADC_REG_GetDMATransfer
N  * @param  ADCx ADC instance
N  * @retval Returned value can be one of the following values:
N  *         @arg @ref LL_ADC_REG_DMA_TRANSFER_NONE
N  *         @arg @ref LL_ADC_REG_DMA_TRANSFER_LIMITED
N  *         @arg @ref LL_ADC_REG_DMA_TRANSFER_UNLIMITED
N  */
N__STATIC_INLINE uint32_t LL_ADC_REG_GetDMATransfer(const ADC_TypeDef *ADCx)
Xstatic __inline uint32_t LL_ADC_REG_GetDMATransfer(const ADC_TypeDef *ADCx)
N{
N  return (uint32_t)(READ_BIT(ADCx->CR2, ADC_CR2_DMA | ADC_CR2_DDS));
X  return (uint32_t)(((ADCx->CR2) & ((0x1UL << (8U)) | (0x1UL << (9U)))));
