Xstatic __inline void LL_ADC_SetDataAlignment(ADC_TypeDef *ADCx, uint32_t DataAlignment)
N{
N  MODIFY_REG(ADCx->CR2, ADC_CR2_ALIGN, DataAlignment);
X  (((ADCx->CR2)) = ((((((ADCx->CR2))) & (~((0x1UL << (11U))))) | (DataAlignment))));
N}
