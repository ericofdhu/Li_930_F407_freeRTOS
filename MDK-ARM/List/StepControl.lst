N/* Exported macro ------------------------------------------------------------*/
N#ifdef  USE_FULL_ASSERT
N/**
N  * @brief  The assert_param macro is used for function's parameters check.
N  * @param  expr If expr is false, it calls assert_failed function
N  *         which reports the name of the source file and the source
N  *         line number of the call that failed.
N  *         If expr is true, it returns no value.
N  * @retval None
N  */
N  #define assert_param(expr) ((expr) ? (void)0U : assert_failed((uint8_t *)__FILE__, __LINE__))
N/* Exported functions ------------------------------------------------------- */
N  void assert_failed(uint8_t* file, uint32_t line);
N#else
S  #define assert_param(expr) ((void)0U)
N#endif /* USE_FULL_ASSERT */
