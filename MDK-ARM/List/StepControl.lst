N 
N/// Mail ID identifies the mail queue.
Ntypedef void *osMailQId;
N 
N 
N/// Thread Definition structure contains startup information of a thread.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef struct os_thread_def {
S  os_pthread                 pthread;   ///< start address of thread function
S  osPriority               tpriority;   ///< initial thread priority
S  uint32_t                 instances;   ///< maximum number of instances of that thread function
S  uint32_t                 stacksize;   ///< stack size requirements in bytes; 0 is default stack size
S} osThreadDef_t;
N#else
Ntypedef struct os_thread_def {
N  os_pthread                 pthread;   ///< start address of thread function
N  osThreadAttr_t                attr;   ///< thread attributes
N} osThreadDef_t;
N#endif
N 
N/// Timer Definition structure contains timer parameters.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef struct os_timer_def {
S  os_ptimer                   ptimer;   ///< start address of a timer function
S} osTimerDef_t;
N#else
Ntypedef struct os_timer_def {
N  os_ptimer                   ptimer;   ///< start address of a timer function
N  osTimerAttr_t                 attr;   ///< timer attributes
N} osTimerDef_t;
N#endif
N 
N/// Mutex Definition structure contains setup information for a mutex.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef struct os_mutex_def {
S  uint32_t                     dummy;   ///< dummy value
S} osMutexDef_t;
N#else
N#define osMutexDef_t osMutexAttr_t
N#endif
N 
N/// Semaphore Definition structure contains setup information for a semaphore.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef struct os_semaphore_def {
S  uint32_t                     dummy;   ///< dummy value
S} osSemaphoreDef_t;
N#else
N#define osSemaphoreDef_t osSemaphoreAttr_t
N#endif
N 
N/// Definition structure for memory block allocation.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef struct os_pool_def {
S  uint32_t                   pool_sz;   ///< number of items (elements) in the pool
S  uint32_t                   item_sz;   ///< size of an item
S  void                         *pool;   ///< pointer to memory for pool
S} osPoolDef_t;
N#else
Ntypedef struct os_pool_def {
N  uint32_t                   pool_sz;   ///< number of items (elements) in the pool
N  uint32_t                   item_sz;   ///< size of an item
N  osMemoryPoolAttr_t            attr;   ///< memory pool attributes
N} osPoolDef_t;
N#endif
N 
N/// Definition structure for message queue.
