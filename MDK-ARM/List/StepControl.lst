N  */
N__STATIC_INLINE uint32_t LL_ADC_GetResolution(const ADC_TypeDef *ADCx)
Xstatic __inline uint32_t LL_ADC_GetResolution(const ADC_TypeDef *ADCx)
N{
N  return (uint32_t)(READ_BIT(ADCx->CR1, ADC_CR1_RES));
X  return (uint32_t)(((ADCx->CR1) & ((0x3UL << (24U)))));
N}
