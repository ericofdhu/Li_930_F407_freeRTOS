N#define GPIO_AFRH_AFRH4_0                GPIO_AFRH_AFSEL12_0
N#define GPIO_AFRH_AFRH4_1                GPIO_AFRH_AFSEL12_1
N#define GPIO_AFRH_AFRH4_2                GPIO_AFRH_AFSEL12_2
N#define GPIO_AFRH_AFRH4_3                GPIO_AFRH_AFSEL12_3
