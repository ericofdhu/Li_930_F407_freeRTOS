NHAL_StatusTypeDef HAL_SPI_DMAResume(SPI_HandleTypeDef *hspi);
NHAL_StatusTypeDef HAL_SPI_DMAStop(SPI_HandleTypeDef *hspi);
N/* Transfer Abort functions */
