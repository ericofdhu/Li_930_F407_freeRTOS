N// ==== Enumerations, structures, defines ====
N 
N/// Priority values.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef enum {
S  osPriorityIdle          = -3,         ///< Priority: idle (lowest)
S  osPriorityLow           = -2,         ///< Priority: low
S  osPriorityBelowNormal   = -1,         ///< Priority: below normal
S  osPriorityNormal        =  0,         ///< Priority: normal (default)
S  osPriorityAboveNormal   = +1,         ///< Priority: above normal
S  osPriorityHigh          = +2,         ///< Priority: high
S  osPriorityRealtime      = +3,         ///< Priority: realtime (highest)
S  osPriorityError         = 0x84,       ///< System cannot determine priority or illegal priority.
S  osPriorityReserved      = 0x7FFFFFFF  ///< Prevents enum down-size compiler optimization.
S} osPriority;
N#else
N#define osPriority osPriority_t
N#endif
N
N/// Entry point of a thread.
Ntypedef void (*os_pthread) (void const *argument);
N 
N/// Entry point of a timer call back function.
Ntypedef void (*os_ptimer) (void const *argument);
N 
N/// Timer type.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef enum {
S  osTimerOnce             = 0,          ///< One-shot timer.
S  osTimerPeriodic         = 1           ///< Repeating timer.
S} os_timer_type;
N#else
N#define os_timer_type osTimerType_t
N#endif
N 
N/// Timeout value.
N#define osWaitForever       0xFFFFFFFFU ///< Wait forever timeout value.
N 
N/// Status code values returned by CMSIS-RTOS functions.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef enum {
S  osOK                    =    0,       ///< Function completed; no error or event occurred.
S  osEventSignal           = 0x08,       ///< Function completed; signal event occurred.
S  osEventMessage          = 0x10,       ///< Function completed; message event occurred.
S  osEventMail             = 0x20,       ///< Function completed; mail event occurred.
S  osEventTimeout          = 0x40,       ///< Function completed; timeout occurred.
S  osErrorParameter        = 0x80,       ///< Parameter error: a mandatory parameter was missing or specified an incorrect object.
S  osErrorResource         = 0x81,       ///< Resource not available: a specified resource was not available.
S  osErrorTimeoutResource  = 0xC1,       ///< Resource not available within given time: a specified resource was not available within the timeout period.
S  osErrorISR              = 0x82,       ///< Not allowed in ISR context: the function cannot be called from interrupt service routines.
S  osErrorISRRecursive     = 0x83,       ///< Function called multiple times from ISR with same object.
S  osErrorPriority         = 0x84,       ///< System cannot determine priority or thread has illegal priority.
S  osErrorNoMemory         = 0x85,       ///< System is out of memory: it was impossible to allocate or reserve memory for the operation.
S  osErrorValue            = 0x86,       ///< Value of a parameter is out of range.
S  osErrorOS               = 0xFF,       ///< Unspecified RTOS error: run-time error but no other error message fits.
S  osStatusReserved        = 0x7FFFFFFF  ///< Prevents enum down-size compiler optimization.
S} osStatus;
N#else
Ntypedef int32_t                  osStatus;
N#define osEventSignal           (0x08)
N#define osEventMessage          (0x10)
N#define osEventMail             (0x20)
N#define osEventTimeout          (0x40)
N#define osErrorOS               osError
N#define osErrorTimeoutResource  osErrorTimeout
N#define osErrorISRRecursive     (-126)
N#define osErrorValue            (-127)
N#define osErrorPriority         (-128)
N#endif
N 
N 
N// >>> the following data type definitions may be adapted towards a specific RTOS
N 
N/// Thread ID identifies the thread.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef void *osThreadId;
N#else
N#define osThreadId osThreadId_t
N#endif
N 
N/// Timer ID identifies the timer.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef void *osTimerId;
N#else
N#define osTimerId osTimerId_t
N#endif
N 
N/// Mutex ID identifies the mutex.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef void *osMutexId;
N#else
N#define osMutexId osMutexId_t
N#endif
N 
N/// Semaphore ID identifies the semaphore.
N#if (osCMSIS < 0x20000U)
X#if (0x20001U < 0x20000U)
Stypedef void *osSemaphoreId;
N#else
N#define osSemaphoreId osSemaphoreId_t
N#endif
N 
N/// Pool ID identifies the memory pool.
Ntypedef void *osPoolId;
N 
N/// Message ID identifies the message queue.
