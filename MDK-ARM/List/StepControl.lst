N/** @brief Reset DAC handle state.
N  * @param  __HANDLE__ specifies the DAC handle.
N  * @retval None
N  */
N#if (USE_HAL_DAC_REGISTER_CALLBACKS == 1)
X#if (0U == 1)
S#define __HAL_DAC_RESET_HANDLE_STATE(__HANDLE__) do {                                                        \
S                                                      (__HANDLE__)->State             = HAL_DAC_STATE_RESET; \
S                                                      (__HANDLE__)->MspInitCallback   = NULL;                \
S                                                      (__HANDLE__)->MspDeInitCallback = NULL;                \
S                                                     } while(0)
X#define __HAL_DAC_RESET_HANDLE_STATE(__HANDLE__) do {                                                                                                              (__HANDLE__)->State             = HAL_DAC_STATE_RESET;                                                       (__HANDLE__)->MspInitCallback   = NULL;                                                                      (__HANDLE__)->MspDeInitCallback = NULL;                                                                     } while(0)
N#else
N#define __HAL_DAC_RESET_HANDLE_STATE(__HANDLE__) ((__HANDLE__)->State = HAL_DAC_STATE_RESET)
N#endif /* USE_HAL_DAC_REGISTER_CALLBACKS */
N
N/** @brief Enable the DAC channel.
N  * @param  __HANDLE__ specifies the DAC handle.
N  * @param  __DAC_Channel__ specifies the DAC channel
N  * @retval None
N  */
N#define __HAL_DAC_ENABLE(__HANDLE__, __DAC_Channel__) \
N  ((__HANDLE__)->Instance->CR |=  (DAC_CR_EN1 << ((__DAC_Channel__) & 0x10UL)))
X#define __HAL_DAC_ENABLE(__HANDLE__, __DAC_Channel__)   ((__HANDLE__)->Instance->CR |=  (DAC_CR_EN1 << ((__DAC_Channel__) & 0x10UL)))
N
N/** @brief Disable the DAC channel.
N  * @param  __HANDLE__ specifies the DAC handle
N  * @param  __DAC_Channel__ specifies the DAC channel.
N  * @retval None
N  */
N#define __HAL_DAC_DISABLE(__HANDLE__, __DAC_Channel__) \
N  ((__HANDLE__)->Instance->CR &=  ~(DAC_CR_EN1 << ((__DAC_Channel__) & 0x10UL)))
X#define __HAL_DAC_DISABLE(__HANDLE__, __DAC_Channel__)   ((__HANDLE__)->Instance->CR &=  ~(DAC_CR_EN1 << ((__DAC_Channel__) & 0x10UL)))
N
N/** @brief Set DHR12R1 alignment.
N  * @param  __ALIGNMENT__ specifies the DAC alignment
N  * @retval None
N  */
N#define DAC_DHR12R1_ALIGNMENT(__ALIGNMENT__) (0x00000008UL + (__ALIGNMENT__))
N
N#if defined(DAC_CHANNEL2_SUPPORT)
X#if 1L
N/** @brief  Set DHR12R2 alignment.
N  * @param  __ALIGNMENT__ specifies the DAC alignment
N  * @retval None
N  */
N#define DAC_DHR12R2_ALIGNMENT(__ALIGNMENT__) (0x00000014UL + (__ALIGNMENT__))
N#endif /* DAC_CHANNEL2_SUPPORT */
N
N/** @brief  Set DHR12RD alignment.
N  * @param  __ALIGNMENT__ specifies the DAC alignment
N  * @retval None
N  */
N#define DAC_DHR12RD_ALIGNMENT(__ALIGNMENT__) (0x00000020UL + (__ALIGNMENT__))
N
N/** @brief Enable the DAC interrupt.
N  * @param  __HANDLE__ specifies the DAC handle
N  * @param  __INTERRUPT__ specifies the DAC interrupt.
N  *          This parameter can be any combination of the following values:
N  *            @arg DAC_IT_DMAUDR1 DAC channel 1 DMA underrun interrupt
N  *            @arg DAC_IT_DMAUDR2 DAC channel 2 DMA underrun interrupt
N  * @retval None
N  */
N#define __HAL_DAC_ENABLE_IT(__HANDLE__, __INTERRUPT__) (((__HANDLE__)->Instance->CR) |= (__INTERRUPT__))
N
N/** @brief Disable the DAC interrupt.
N  * @param  __HANDLE__ specifies the DAC handle
N  * @param  __INTERRUPT__ specifies the DAC interrupt.
N  *          This parameter can be any combination of the following values:
N  *            @arg DAC_IT_DMAUDR1 DAC channel 1 DMA underrun interrupt
N  *            @arg DAC_IT_DMAUDR2 DAC channel 2 DMA underrun interrupt
N  * @retval None
N  */
N#define __HAL_DAC_DISABLE_IT(__HANDLE__, __INTERRUPT__) (((__HANDLE__)->Instance->CR) &= ~(__INTERRUPT__))
N
N/** @brief  Check whether the specified DAC interrupt source is enabled or not.
N  * @param __HANDLE__ DAC handle
N  * @param __INTERRUPT__ DAC interrupt source to check
N  *          This parameter can be any combination of the following values:
N  *            @arg DAC_IT_DMAUDR1 DAC channel 1 DMA underrun interrupt
N  *            @arg DAC_IT_DMAUDR2 DAC channel 2 DMA underrun interrupt
N  * @retval State of interruption (SET or RESET)
N  */
N#define __HAL_DAC_GET_IT_SOURCE(__HANDLE__, __INTERRUPT__) (((__HANDLE__)->Instance->CR\
N                                                             & (__INTERRUPT__)) == (__INTERRUPT__))
X#define __HAL_DAC_GET_IT_SOURCE(__HANDLE__, __INTERRUPT__) (((__HANDLE__)->Instance->CR                                                             & (__INTERRUPT__)) == (__INTERRUPT__))
N
N/** @brief  Get the selected DAC's flag status.
N  * @param  __HANDLE__ specifies the DAC handle.
N  * @param  __FLAG__ specifies the DAC flag to get.
N  *          This parameter can be any combination of the following values:
N  *            @arg DAC_FLAG_DMAUDR1 DAC channel 1 DMA underrun flag
N  *            @arg DAC_FLAG_DMAUDR2 DAC channel 2 DMA underrun flag
N  * @retval None
N  */
N#define __HAL_DAC_GET_FLAG(__HANDLE__, __FLAG__) ((((__HANDLE__)->Instance->SR) & (__FLAG__)) == (__FLAG__))
N
N/** @brief  Clear the DAC's flag.
N  * @param  __HANDLE__ specifies the DAC handle.
N  * @param  __FLAG__ specifies the DAC flag to clear.
N  *          This parameter can be any combination of the following values:
N  *            @arg DAC_FLAG_DMAUDR1 DAC channel 1 DMA underrun flag
N  *            @arg DAC_FLAG_DMAUDR2 DAC channel 2 DMA underrun flag
N  * @retval None
N  */
N#define __HAL_DAC_CLEAR_FLAG(__HANDLE__, __FLAG__) (((__HANDLE__)->Instance->SR) = (__FLAG__))
N
N/**
N  * @}
N  */
N
