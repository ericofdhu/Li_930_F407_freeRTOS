Xstatic __inline uint32_t LL_ADC_GetDataAlignment(const ADC_TypeDef *ADCx)
N{
N  return (uint32_t)(READ_BIT(ADCx->CR2, ADC_CR2_ALIGN));
X  return (uint32_t)(((ADCx->CR2) & ((0x1UL << (11U)))));
