N  *         @arg @ref LL_ADC_REG_SEQ_DISCONT_7RANKS
N  *         @arg @ref LL_ADC_REG_SEQ_DISCONT_8RANKS
N  * @retval None
N  */
N__STATIC_INLINE void LL_ADC_REG_SetSequencerDiscont(ADC_TypeDef *ADCx, uint32_t SeqDiscont)
