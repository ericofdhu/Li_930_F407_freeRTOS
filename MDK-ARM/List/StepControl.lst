X#define IS_DAC_ALIGN(ALIGN) (((ALIGN) == DAC_ALIGN_12B_R) ||                              ((ALIGN) == DAC_ALIGN_12B_L) ||                              ((ALIGN) == DAC_ALIGN_8B_R))
N
