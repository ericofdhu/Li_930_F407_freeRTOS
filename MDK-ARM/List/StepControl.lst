Xstatic __inline void LL_ADC_ClearFlag_EOCS(ADC_TypeDef *ADCx)
N{
N  WRITE_REG(ADCx->SR, ~LL_ADC_FLAG_EOCS);
X  ((ADCx->SR) = (~(0x1UL << (1U))));
