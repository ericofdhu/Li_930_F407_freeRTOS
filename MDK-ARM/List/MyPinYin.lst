N//"========================================Ö÷³ÌÐòÌå========================================"
N
Nconst char * py_ime(unsigned char input_py[])
N{
N	const typPinYin* p1;
N	const typPinYin* p2;
N	const char* ret;
N	uint8_t* pInput = input_py;
N	
N	while(*pInput != '\0')
N	{
N		if(*pInput>=0x80)
N			pInput+=2;
N		else
N			break;
N	}
N	
N	if (pInput[0]==0) return(0);																				//"Èç¹ûÊäÈë¿Õ×Ö·û·µ»Ø0"
N	if(pInput[0]<'a' || pInput[0]>'z') return (0);
N	if (pInput[0]=='i') return(0);
N	if (pInput[0]=='u') return(0);
N	if (pInput[0]=='v') return(0);
N//	if (input_py_val[0]=='i') return(0);
N//	if (input_py_val[0]=='u') return(0);
N//	if (input_py_val[0]=='v') return(0);
N	
N	
N	p1=PY_index_pointer[pInput[0]-0x61];															//"¼ÆËãÈë¿ÚÊ÷¸ù"
N	p2=PY_index_pointer[pInput[0]-0x60];																//"ÉèÖÃÖ¸Õë½çÏÞ"
N	while(p1<p2)
N	{
N		if(strcmp(p1->YunMu,(const char*)&pInput[1])== 0 )
N		{
N//			ret = (const char*)(p1->offset_high *256 + p1->offset_low +py_mb_begin);
N			ret = (const char*)(p1->MB);
N			return ret;
N		}
N		else
N		{
N			p1++;
N		}
N	}
N	
N	return 0;
N}
