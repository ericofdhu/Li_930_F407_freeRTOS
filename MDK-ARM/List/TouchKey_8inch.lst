N/* configPRECONDITION should be defined as configASSERT.
NThe CBMC proofs need a way to track assumptions and assertions.
NA configPRECONDITION statement should express an implicit invariant or
Nassumption made.  A configASSERT statement should express an invariant that must
Nhold explicit before calling the code. */
N#ifndef configPRECONDITION
N	#define configPRECONDITION( X ) configASSERT(X)
N	#define configPRECONDITION_DEFINED 0
N#else
S	#define configPRECONDITION_DEFINED 1
N#endif
