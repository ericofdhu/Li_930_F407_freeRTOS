Nconst TOUCH_KEY_SQUARE* AnalyseKeyCodate(TOUCH_POINT point)
N{
N	const TOUCH_KEY_SQUARE*  p=0;
N	const TOUCH_KEY_SQUARE* ret= 0;
N	FATHER_WINDOWS_CONTROL_TABLE* 	p_father_win;
N	CHILD_WINDOWS_CONTROL_TABLE* 		p_child_win;
N
N	p_father_win = (FATHER_WINDOWS_CONTROL_TABLE*)FatherWinTbl;
N	p_child_win = (CHILD_WINDOWS_CONTROL_TABLE*)ChildWinTbl;
N
N
N	
N	if(	ColorWm.IsChildFlag == 0)
N	{
N
N		while(p_father_win->win_num != 0xff)
N		{
N			if(p_father_win->win_num == ColorWm.FatherWindowNumber)
N			{
N				p = p_father_win->tks;
N				break;
N			}
N			else
N			{
N				p_father_win++;
N			}
N		}
N
N		if(p_father_win->win_num == 0xff )
N		{
N			return ret;
N		}
N
N		while(p->code != 0xffff)
N		{
N			if((point.x >= p->left) &&(point.x <= p->left+ p->width) &&  (point.y >= p->top) &&(point.y <= p->top+ p->height) )
N			{
N				ret = p;
N				break;
N			}
N			else
N			{
N				p++;
N			}
N				
N		}
N	}
N	else if(	ColorWm.IsChildFlag == 1)
N	{
N
N		while(p_child_win->win_num != 0xff)
N		{
N			if(p_child_win->win_num == ColorWm.ChildWindowNumber)
N			{
N				p = p_child_win->tks;
N				break;
N			}
N			else
N			{
N				p_child_win++;
N			}
N		}
N
N		if(p_child_win->win_num == 0xff )
N		{
N			return ret;
N		}
N//=================================
N		point.x -= ColorWm.ChildWin_Xpos;
N		point.y -= ColorWm.ChildWin_Ypos;
N		while(p->code != 0xffff)
N		{
N			if((point.x >= p->left) &&(point.x <= p->left+ p->width) &&  (point.y >= p->top) &&(point.y <= p->top+ p->height) )
N			{
N				ret = p;
N				break;
N			}
N			else
N			{
N				p++;
N			}
N				
N		}
N	}
N	else if(	ColorWm.IsChildFlag == 2)
N	{
N
N		while(p_child_win->win_num != 0xff)
N		{
N			if(p_child_win->win_num == ColorWm.SecondChildWindowNumber)
N			{
N				p = p_child_win->tks;
N				break;
N			}
N			else
N			{
N				p_child_win++;
N			}
N		}
N
N		if(p_child_win->win_num == 0xff )
N		{
N			return ret;
N		}
N//=================================
N		point.x -= ColorWm.SecondChildWin_Xpos;
N		point.y -= ColorWm.SecondChildWin_Ypos;
N		while(p->code != 0xffff)
N		{
N			if((point.x >= p->left) &&(point.x <= p->left+ p->width) &&  (point.y >= p->top) &&(point.y <= p->top+ p->height) )
N			{
N				ret = p;
N				break;
N			}
N			else
N			{
N				p++;
N			}
N				
N		}
N	}
N
N	return ret;
N}
N
N
N#endif
