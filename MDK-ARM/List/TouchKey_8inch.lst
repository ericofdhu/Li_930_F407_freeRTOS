N/**
N * @brief ½âÎö´¥ÃþÆÁ±¨ÎÄ²¢¸üÐÂ°´¼ü×´Ì¬¡¢°´¼ü·´À¡¼°´°¿ÚÊÂ¼þ¶ÓÁÐ¡£
N * @param msg Ö¸ÏòÖÁÉÙ 6 ×Ö½ÚµÄ´¥ÃþÆÁ±¨ÎÄ£»Ê××Ö½ÚÎª 0xAA£¬µÚ¶þ×Ö½Ú 0x73 ±íÊ¾°´ÏÂ¡¢0x72 ±íÊ¾ÊÍ·Å¡£
N * @retval 0 ±¨ÎÄ´¦ÀíÍê³É»ò±¨ÎÄÀàÐÍÎ´´¦Àí£»1 ÊäÈëÖ¸ÕëÎÞÐ§»ò´¥ÃþÊÂ¼þÈë¶ÓÊ§°Ü¡£
N * @note °´ÏÂ±¨ÎÄÖÐµÄ×ø±êÓÃÓÚÃüÖÐ¼ì²â£»ÃüÖÐ°´¼üÊ±¸üÐÂÈ«¾Ö°´¼ü×´Ì¬²¢Í¨Öªµ±Ç°¸¸´°¿Ú»ò×Ó´°¿Ú¡£
N */
Nuint8_t Get_TouchKeyAssignments(uint8_t* msg)
N{
N	TOUCH_POINT pt;
N	if (msg == NULL)
X	if (msg == 0)
N	{
N		return 1U;
N	}
N
N	if(msg[0] == 0xaa)
N	{
N		if (msg[1] == 0x73)// ´¥Ãþ°´ÏÂÊÂ¼þ¡£
N		{
N			pt.x = msg[2]*256+msg[3];
N			pt.y = msg[4]*256+msg[5];
N			TouchKey.x = pt.x;
N			TouchKey.y = pt.y;	
N			TouchKey.p = AnalyseKeyCodate(pt);
N			
N			if(TouchKey.p == 0)
N			{
N				TouchKey.back_keyassignments = 0xffff;
N				TouchKey.current_keyassignments = 0xffff;
N				TouchKey.Trg = 0;
N				TouchKey.Press = 0;
N			}
N			else
N			{
N				TouchKey.current_keyassignments = TouchKey.p->code;
N			}
N			if(TouchKey.current_keyassignments != 0xffff)
N			{
N				if(TouchKey.Press == 0)
N				{
N					TouchKey.back_p = (TOUCH_KEY_SQUARE*)TouchKey.p;
N					TouchKey.back_keyassignments = TouchKey.back_p ->code;// ±£´æµ±Ç°°´ÏÂµÄ°´¼ü£»½öÔÚ°´ÏÂÑØ¸üÐÂÒ»´Î¡£
N					BEEP_ONCE();
X					SysRun_SetBeep(100);
N					if(TouchKey.p->flag == 1)
N					{
N						if(ColorWm.IsChildFlag == 0)
N						{
N							ColorLcdDispIcon(
N													TouchKey.p->tICON->cut_num,
N													TouchKey.p->tICON->left,
N													TouchKey.p->tICON->top,
N													TouchKey.p->tICON->left + TouchKey.p->tICON->width,
N													TouchKey.p->tICON->top + TouchKey.p->tICON->height,
N													TouchKey.p->paint_x,
N													TouchKey.p->paint_y);
N						}
N						else if(ColorWm.IsChildFlag == 1)
N						{
N							ColorLcdDispIcon1(
N													TouchKey.p->tICON->cut_num,
N													TouchKey.p->tICON->left+ColorWm.ChildWinIcon->left,
N													TouchKey.p->tICON->top+ColorWm.ChildWinIcon->top,
N													TouchKey.p->tICON->left+ColorWm.ChildWinIcon->left+TouchKey.p->tICON->width,
N													TouchKey.p->tICON->top+ColorWm.ChildWinIcon->top+TouchKey.p->tICON->height,
N													TouchKey.p->paint_x + ColorWm.ChildWin_Xpos,
N													TouchKey.p->paint_y + ColorWm.ChildWin_Ypos);
N						}
N						else if(ColorWm.IsChildFlag == 2)
N						{
N							ColorLcdDispIcon1(
N													TouchKey.p->tICON->cut_num,
N													TouchKey.p->tICON->left+ColorWm.SecondChildWinIcon->left,
N													TouchKey.p->tICON->top+ColorWm.SecondChildWinIcon->top,
N													TouchKey.p->tICON->left+ColorWm.SecondChildWinIcon->left+TouchKey.p->tICON->width,
N													TouchKey.p->tICON->top+ColorWm.SecondChildWinIcon->top+TouchKey.p->tICON->height,
N													TouchKey.p->paint_x + ColorWm.SecondChildWin_Xpos,
N													TouchKey.p->paint_y + ColorWm.SecondChildWin_Ypos);
N						}
N						
N					}
N					else if(TouchKey.p->flag == 2)
N					{
N						ColorLcdDispIcon(
N													TouchKey.p->paint_x,// »æÖÆ°´¼ü¶ÔÓ¦µÄÍ¼±ê¡£
N													TouchKey.p->left,
N													TouchKey.p->top,
N													TouchKey.p->left+TouchKey.p->width,
N													TouchKey.p->top+TouchKey.p->height,
N													TouchKey.p->left,
N													TouchKey.p->top);
N					}
N					TouchKey.Trg = 1;// ÖÃÎ»´¥Ãþ´¥·¢±êÖ¾¡£
N					TouchKey.Press = 1;// ÖÃÎ»°´ÏÂ×´Ì¬±êÖ¾¡£
N					TouchKey.Release = 0;// Çå³ýÊÍ·Å×´Ì¬±êÖ¾¡£
N					if (TouchKey_PostEvent(
N							(ColorWm.IsChildFlag == 0U) ?
N							TOUCH_KEY_EVENT_FATHER :
X							0U :
N							((ColorWm.IsChildFlag == 1U) ?
N							 TOUCH_KEY_EVENT_CHILD :
X							 1U :
N							 TOUCH_KEY_EVENT_SECOND_CHILD)) != osOK)
X							 2U)) != osOK)
N					{
N						return 1U;
N					}
N				}
N				else
N				{
N					TouchKey.Trg = 0;
N					TouchKey.Press = 1;
N					TouchKey.Release = 0;
N					if (TouchKey_PostEvent(
N							(ColorWm.IsChildFlag == 0U) ?
N							TOUCH_KEY_EVENT_FATHER :
X							0U :
N							((ColorWm.IsChildFlag == 1U) ?
N							 TOUCH_KEY_EVENT_CHILD :
X							 1U :
N							 TOUCH_KEY_EVENT_SECOND_CHILD)) != osOK)
X							 2U)) != osOK)
N					{
N						return 1U;
N					}
N				}
N			}
N			else
N			{
N				//TouchKey.back_keyassignments = 0xffff;
N				TouchKey.current_keyassignments = 0xffff;
N				TouchKey.Trg = 0;
N				TouchKey.Press = 0;
N			}
N				
N		}
N		else if (msg[1] == 0x72)// ´¥ÃþÊÍ·ÅÊÂ¼þ¡£
N		{
N			//pt.x = msg[2]*256+msg[3];
N			//pt.y = msg[4]*256+msg[5];
N			//TouchKey.p = AnalyseKeyCodate(pt,wm.WindowNumber,wm.instr_ext);
N			//TouchKey.p = TouchKey.back_p ;
N			if((TouchKey.back_keyassignments != 0xffff) && (TouchKey.back_p->flag >0)) 
N			{
N				if(ColorWm.IsChildFlag == 0)
N				{
N					if(TouchKey.back_p->flag == 1)// °´¼ü´øÓÐ°´ÏÂ·´À¡Ð§¹û¡£
N					{
N						ColorLcdDispIcon(		ColorWm.FatherPicNumber,
N											TouchKey.back_p->paint_x ,
N											TouchKey.back_p->paint_y ,
N											TouchKey.back_p->paint_x + TouchKey.back_p->tICON->width,
N											TouchKey.back_p->paint_y + TouchKey.back_p->tICON->height,
N											TouchKey.back_p->paint_x ,
N											TouchKey.back_p->paint_y );
N					}
N					else if(TouchKey.back_p->flag == 2)// °´¼ü´øÓÐ°´ÏÂ·´À¡£¬²¢ÐèÇÐ»»×´Ì¬Í¼±ê¡£
N					{
