N													TouchKey.p->top);
N					}
N				}
N				else if (ColorWm.IsChildFlag == 1) 
N				{
N					ColorLcdDispIcon1(		ColorWm.ChildWinIcon->cut_num ,
N											TouchKey.back_p->paint_x + ColorWm.ChildWinIcon->left,
N											TouchKey.back_p->paint_y + ColorWm.ChildWinIcon->top,
N											TouchKey.back_p->paint_x + ColorWm.ChildWinIcon->left+ TouchKey.back_p->tICON->width,
