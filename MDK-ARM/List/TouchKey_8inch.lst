N#define TOUCH_KEY_EVENT_QUEUE_LENGTH 1U
N
Nstatic osMessageQueueId_t TouchKeyFatherEventQueue;
Nstatic osMessageQueueId_t TouchKeyChildEventQueue;
N
N/**
N * @brief ´´½¨Ö÷´°¿ÚºÍ×Ó´°¿Ú¸÷×ÔÊ¹ÓÃµÄ´¥ÃþÊÂ¼þ¶ÓÁÐ¡£
N * @param ÎÞ¡£
N * @retval ¶ÓÁÐÒÑ´æÔÚ»ò´´½¨³É¹¦Ê±·µ»Ø osOK£»ÄÚ´æ²»×ã»òÉ¾³ý¾É¶ÓÁÐÊ§°ÜÊ±·µ»Ø¶ÔÓ¦´íÎó¡£
N * @note Á½¸ö¶ÓÁÐ·Ö±ð»º´æ×îÐÂµÄ¸¸´°¿ÚºÍ×Ó´°¿ÚÊÂ¼þ£¬±ÜÃâÏÔÊ¾ÈÎÎñ»¥ÏàÈ¡×ß¶Ô·½µÄÊÂ¼þ¡£
N */
NosStatus_t TouchKeyEventQueue_Init(void)
N{
N	osStatus_t status;
N
N	if ((TouchKeyFatherEventQueue != NULL) &&
X	if ((TouchKeyFatherEventQueue != 0) &&
N		(TouchKeyChildEventQueue != NULL))
X		(TouchKeyChildEventQueue != 0))
N	{
N		return osOK;
N	}
N
N	if (TouchKeyFatherEventQueue != NULL)
X	if (TouchKeyFatherEventQueue != 0)
N	{
N		status = osMessageQueueDelete(TouchKeyFatherEventQueue);
N		if (status != osOK)
N		{
N			return status;
N		}
N		TouchKeyFatherEventQueue = NULL;
X		TouchKeyFatherEventQueue = 0;
N	}
N	if (TouchKeyChildEventQueue != NULL)
X	if (TouchKeyChildEventQueue != 0)
N	{
N		status = osMessageQueueDelete(TouchKeyChildEventQueue);
N		if (status != osOK)
N		{
N			return status;
N		}
N		TouchKeyChildEventQueue = NULL;
X		TouchKeyChildEventQueue = 0;
N	}
N
N	TouchKeyFatherEventQueue = osMessageQueueNew(
N		TOUCH_KEY_EVENT_QUEUE_LENGTH, sizeof(uint8_t), NULL);
X		1U, sizeof(uint8_t), 0);
N	if (TouchKeyFatherEventQueue == NULL)
X	if (TouchKeyFatherEventQueue == 0)
N	{
N		return osErrorNoMemory;
N	}
N
N	TouchKeyChildEventQueue = osMessageQueueNew(
N		TOUCH_KEY_EVENT_QUEUE_LENGTH, sizeof(uint8_t), NULL);
X		1U, sizeof(uint8_t), 0);
N	if (TouchKeyChildEventQueue == NULL)
X	if (TouchKeyChildEventQueue == 0)
N	{
N		status = osMessageQueueDelete(TouchKeyFatherEventQueue);
N		if (status != osOK)
N		{
N			return status;
N		}
N		TouchKeyFatherEventQueue = NULL;
X		TouchKeyFatherEventQueue = 0;
N		return osErrorNoMemory;
N	}
N
N	return osOK;
N}
N
N/**
N * @brief ´ÓÖ¸¶¨´°¿Ú¶ÔÓ¦µÄ´¥ÃþÊÂ¼þ¶ÓÁÐÖÐµÈ´ý²¢¶ÁÈ¡Ò»¸öÊÂ¼þ¡£
N * @param eventType ÒªµÈ´ýµÄÊÂ¼þÀàÐÍ£¬½öÖ§³Ö TOUCH_KEY_EVENT_FATHER »ò TOUCH_KEY_EVENT_CHILD¡£
N * @param event ÓÃÓÚ½ÓÊÕÊÂ¼þ±àºÅµÄÊä³öÖ¸Õë£¬²»µÃÎª NULL¡£
N * @param timeout µÈ´ý¶ÓÁÐÏûÏ¢µÄ³¬Ê±Ê±¼ä£¬µ¥Î»Îª RTOS ÏµÍ³Ê±ÖÓ½ÚÅÄ¡£
N * @retval ·µ»Ø CMSIS-RTOS ÏûÏ¢¶ÓÁÐ½Ó¿ÚµÄ×´Ì¬£»²ÎÊý»òÊÂ¼þÀàÐÍÎÞÐ§Ê±·µ»Ø osErrorParameter¡£
N */
NosStatus_t TouchKeyEventQueue_Get(uint8_t eventType, uint8_t *event, uint32_t timeout)
N{
N	osMessageQueueId_t eventQueue;
N
N	if (event == NULL)
X	if (event == 0)
N	{
N		return osErrorParameter;
N	}
N
N	switch (eventType)
N	{
N		case TOUCH_KEY_EVENT_FATHER:
X		case 0U:
N			eventQueue = TouchKeyFatherEventQueue;
N			break;
N		case TOUCH_KEY_EVENT_CHILD:
X		case 1U:
N			eventQueue = TouchKeyChildEventQueue;
N			break;
N		default:
N			return osErrorParameter;
N	}
N
N	if (eventQueue == NULL)
X	if (eventQueue == 0)
N	{
N		return osErrorParameter;
N	}
N
N	return osMessageQueueGet(eventQueue, event, NULL, timeout);
X	return osMessageQueueGet(eventQueue, event, 0, timeout);
N}
N
N/**
N * @brief ½«´¥ÃþÊÂ¼þÍ¶µÝµ½¶ÔÓ¦´°¿ÚµÄ¶ÓÁÐ£¬²¢ÔÚ¶ÓÁÐÒÑÂúÊ±±£Áô×îÐÂÊÂ¼þ¡£
N * @param event ÒªÍ¶µÝµÄ´¥ÃþÊÂ¼þ±àºÅ¡£
N * @retval ·µ»Ø CMSIS-RTOS ÏûÏ¢¶ÓÁÐ½Ó¿ÚµÄ×´Ì¬£»¶þ¼¶×Ó´°¿ÚÊÂ¼þ²»ÔÙ´¥·¢´°¿ÚÖØ»æ¡£
N * @note ¸¸´°¿ÚºÍ×Ó´°¿ÚÊ¹ÓÃ¶ÀÁ¢¶ÓÁÐ£»¶ÓÁÐÂúÊ±¶ªÆú¸Ã´°¿ÚµÄ¾ÉÊÂ¼þºóÔÙÐ´ÈëÐÂÊÂ¼þ¡£
N */
Nstatic osStatus_t TouchKey_PostEvent(uint8_t event)
N{
N	osMessageQueueId_t eventQueue;
N	osStatus_t status;
N	uint8_t pendingEvent;
N
N	if (event == TOUCH_KEY_EVENT_SECOND_CHILD)
X	if (event == 2U)
N	{
N		return osOK;
N	}
N
N	switch (event)
N	{
N		case TOUCH_KEY_EVENT_FATHER:
X		case 0U:
N			eventQueue = TouchKeyFatherEventQueue;
N			break;
N		case TOUCH_KEY_EVENT_CHILD:
X		case 1U:
N			eventQueue = TouchKeyChildEventQueue;
N			break;
N		default:
N			return osErrorParameter;
N	}
N
N	if (eventQueue == NULL)
X	if (eventQueue == 0)
N	{
N		return osErrorParameter;
N	}
N
N	status = osMessageQueuePut(eventQueue, &event, 0U, 0U);
N	if (status == osErrorResource)
N	{
N		status = osMessageQueueGet(eventQueue, &pendingEvent, NULL, 0U);
X		status = osMessageQueueGet(eventQueue, &pendingEvent, 0, 0U);
N		if ((status != osOK) && (status != osErrorResource))
N		{
N			return status;
N		}
N		status = osMessageQueuePut(eventQueue, &event, 0U, 0U);
N	}
N
N	return status;
N}
N/**
N * @brief ³õÊ¼»¯´¥Ãþ°´¼ü×´Ì¬¼°×ÖÄ¸¼üÅÌÃû³ÆÊäÈëÀàÐÍ¡£
N * @param ÎÞ¡£
N * @retval ÎÞ¡£
N * @note Çå³ýÉÏ´Î°´¼ü¡¢µ±Ç°°´¼ü¡¢´¥·¢¡¢°´ÏÂºÍÊÍ·Å×´Ì¬£¬²¢½«Ãû³ÆÊäÈëÀàÐÍÉèÎªÄ¬ÈÏÖµ 0¡£
N */
Nvoid TouchKey_Init(void)
N{
N	TouchKey.back_keyassignments = 0xffff;
N	TouchKey.current_keyassignments = 0xffff;
N	TouchKey.Trg = 0;
N
N	TouchKey.Press = 0;
N	TouchKey.Release = 0;
N	AlphabetKeyboard.NameType = 0;
N
N}
