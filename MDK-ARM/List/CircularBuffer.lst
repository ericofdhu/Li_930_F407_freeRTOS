N/*
N*********************************************************************************************************
N*                                             CircularBuffer_Init()
N*
N* Description : 初始化环形缓冲区
N*
N* Argument(s) : buffer - 缓冲区结构体指针
N*               data_buffer - 数据存储数组
N*               size - 缓冲区大小
N*
N* Return(s)   : 无
N*
N* Caller(s)   : 需要初始化环形缓冲区的函数
N*
N* Note(s)     : 
N*               - 缓冲区大小必须大于0
N*               - 数据存储数组必须足够大（size个元素）
N*               - 初始化后缓冲区为空
N*********************************************************************************************************
N*/
N
N
Nvoid CircularBuffer_Init(CircularBuffer *buffer, int32_t *data_buffer, int size)
N{
N    buffer->buffer = data_buffer;
N    buffer->size = size;
N    buffer->head = 0;
N    buffer->tail = 0;
N    buffer->count = 0;
N    buffer->sum = 0;
N    
N    /* 可选：清空缓冲区 */
N    int i;
N    for (i = 0; i < size; i++) {
N        data_buffer[i] = 0;
N    }
N}
N/*
N*********************************************************************************************************
N*                                             CircularBuffer_Push()
N*
N* Description : 向环形缓冲区添加新数据
N*
N* Argument(s) : buffer - 缓冲区结构体指针
N*               value - 要添加的数据值
N*
N* Return(s)   : 无
N*
N* Caller(s)   : 需要向缓冲区添加数据的函数
N*
N* Note(s)     : 
N*               - 如果缓冲区已满，会覆盖最旧的数据
N*               - 自动更新总和，便于快速计算平均值
N*********************************************************************************************************
N*/
Nvoid CircularBuffer_Push(CircularBuffer *buffer, float value)
N{
N    if (buffer->count == buffer->size) {
N        /* 缓冲区已满，移除最旧的数据 */
N        buffer->sum -= buffer->buffer[buffer->tail];
N        buffer->tail = (buffer->tail + 1) % buffer->size;
N        buffer->count--;
N    }
N    
N    /* 添加新数据 */
N    buffer->buffer[buffer->head] = value;
N    buffer->head = (buffer->head + 1) % buffer->size;
N    buffer->count++;
N    buffer->sum += value;
N}
N/*
N*********************************************************************************************************
N*                                             CircularBuffer_GetAverage()
N*
N* Description : 计算环形缓冲区中数据的平均值
N*
N* Argument(s) : buffer - 缓冲区结构体指针
N*
N* Return(s)   : 平均值（整数，四舍五入）
N*
N* Caller(s)   : 需要获取平均值的函数
N*
N* Note(s)     : 
N*               - 如果缓冲区为空，返回0
N*               - 使用预计算的总和，计算效率高
N*               - 结果四舍五入为整数
N*********************************************************************************************************
N*/
Nint CircularBuffer_GetAverage(CircularBuffer *buffer)
N{
N    if (buffer->count == 0) {
N        return 0;
N    }
N    
N    /* 计算平均值并四舍五入 */
N    return (int)((buffer->sum + buffer->count / 2) / buffer->count);
N}
N/*
N*********************************************************************************************************
N*                                             CircularBuffer_GetAverageFloat()
N*
N* Description : 计算环形缓冲区中数据的平均值（浮点数）
N*
N* Argument(s) : buffer - 缓冲区结构体指针
N*
N* Return(s)   : 平均值（浮点数）
N*
N* Caller(s)   : 需要高精度平均值的函数
N*
N* Note(s)     : 
N*               - 如果缓冲区为空，返回0.0
N*               - 提供更高的精度
N*********************************************************************************************************
N*/
Nfloat CircularBuffer_GetAverageFloat(CircularBuffer *buffer)
N{
N    if (buffer->count == 0) {
N        return 0.0f;
N    }
N    
N    return (float)buffer->sum / (float)buffer->count;
N}
N/*
N*********************************************************************************************************
N*                                             CircularBuffer_Clear()
N*
N* Description : 清空环形缓冲区
N*
N* Argument(s) : buffer - 缓冲区结构体指针
N*
N* Return(s)   : 无
N*
N* Caller(s)   : 需要重置缓冲区的函数
N*
N* Note(s)     : 
N*               - 清空所有数据，重置为初始状态
N*               - 总和归零，计数归零
N*********************************************************************************************************
N*/
Nvoid CircularBuffer_Clear(CircularBuffer *buffer)
N{
N    buffer->head = 0;
N    buffer->tail = 0;
N    buffer->count = 0;
N    buffer->sum = 0;
N}
N/*
N*********************************************************************************************************
N*                                             CircularBuffer_GetCount()
N*
N* Description : 获取环形缓冲区中当前元素个数
N*
N* Argument(s) : buffer - 缓冲区结构体指针
N*
N* Return(s)   : 元素个数
N*
N* Caller(s)   : 需要知道缓冲区大小的函数
N*
N* Note(s)     : 
N*               - 返回当前缓冲区中的有效数据个数
N*********************************************************************************************************
N*/
Nint CircularBuffer_GetCount(CircularBuffer *buffer)
N{
N    return buffer->count;
N}
N/*
N*********************************************************************************************************
N*                                             CircularBuffer_IsFull()
N*
N* Description : 检查环形缓冲区是否已满
N*
N* Argument(s) : buffer - 缓冲区结构体指针
N*
N* Return(s)   : 1-已满，0-未满
N*
N* Caller(s)   : 需要检查缓冲区状态的函数
N*
N* Note(s)     : 
N*               - 缓冲区满时，新数据会覆盖旧数据
N*********************************************************************************************************
N*/
Nint CircularBuffer_IsFull(CircularBuffer *buffer)
N{
N    return buffer->count == buffer->size;
N}
N/*
N*********************************************************************************************************
N*                                             CircularBuffer_IsEmpty()
N*
N* Description : 检查环形缓冲区是否为空
N*
N* Argument(s) : buffer - 缓冲区结构体指针
N*
N* Return(s)   : 1-为空，0-不为空
N*
N* Caller(s)   : 需要检查缓冲区状态的函数
N*
N* Note(s)     : 
N*               - 缓冲区空时，无法获取有效平均值
N*********************************************************************************************************
N*/
Nint CircularBuffer_IsEmpty(CircularBuffer *buffer)
N{
N    return buffer->count == 0;
N}
N
