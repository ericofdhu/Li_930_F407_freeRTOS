N#define  CIRCULAR_BUFFER
N/* 环形缓冲区结构体 */
Ntypedef struct {
N    int32_t *buffer;        /* 缓冲区指针 */
N    int size;          /* 缓冲区大小 */
N    int head;          /* 缓冲区头部索引 */
N    int tail;          /* 缓冲区尾部索引 */
N    int count;         /* 当前元素个数 */
N    float sum;     /* 当前总和（用于快速计算平均值） */
N} CircularBuffer;
N
N
N
N
N#define WAVE_BUFF_LEN   5
Nextern int32_t wave_Buffer[WAVE_BUFF_LEN];
Xextern int32_t wave_Buffer[5];
Nextern CircularBuffer cb_wave;
N
N
N
N#define TIME_BUFF_LEN   30
Nextern int32_t time_Buffer[TIME_BUFF_LEN];
Xextern int32_t time_Buffer[30];
Nextern CircularBuffer cb_time;
N
N
N
N
N#define NORMAL_BUFF_LEN   30
Nextern int32_t normal_Buffer[NORMAL_BUFF_LEN];
Xextern int32_t normal_Buffer[30];
Nextern CircularBuffer cb_normal;
N
N
N
N
N
N
N
N/* 函数声明 */
Nvoid CircularBuffer_Init(CircularBuffer *buffer, int32_t *data_buffer, int size);
Nvoid CircularBuffer_Push(CircularBuffer *buffer, float value);
Nint CircularBuffer_GetAverage(CircularBuffer *buffer);
Nfloat CircularBuffer_GetAverageFloat(CircularBuffer *buffer);
Nvoid CircularBuffer_Clear(CircularBuffer *buffer);
Nint CircularBuffer_GetCount(CircularBuffer *buffer);
Nint CircularBuffer_IsFull(CircularBuffer *buffer);
Nint CircularBuffer_IsEmpty(CircularBuffer *buffer);
N
N
N
