N//低通滤波二阶巴特沃斯，截止频率=50Hz
Nconst float LPF_1000Hz[8] = {
N    0.0201f, 0.0402f, 0.0201f,   // b0, b1, b2
N    1.0f,   -1.5610f, 0.6414f,    // a0, a1, a2
N    1.0f,    1.0f                  // gain0, gain1
N};
N//采样率 1000 Hz，截止频率 10 Hz
Nconst float LPF_1000Hz_10Hz[8] = {
N    0.0009448f, 0.0018896f, 0.0009448f,   // b0, b1, b2
N    1.0f,       -1.9112f,    0.9149f,      // a0, a1, a2
N    1.0f,        1.0f                      // gain0, gain1
N};
N//采样率 1000 Hz，截止频率 30 Hz
Nconst float LPF_1000Hz_30Hz[8] = {
N    0.0078f, 0.0156f, 0.0078f,   // b0, b1, b2
N    1.0f,   -1.7347f, 0.7658f,    // a0, a1, a2
N    1.0f,    1.0f                  // gain0, gain1
N};
N//采样率 10000 Hz，截止频率 20 Hz
Nconst float LPF_10000Hz_20Hz[8] = {
N    0.00003913f, 0.00007826f, 0.00003913f,   // b0, b1, b2
N    1.0f,        -1.9823f,     0.9824f,       // a0, a1, a2
N    1.0f,         1.0f                        // gain0, gain1
N};
N//一阶低通滤波器（RC 型）
Nconst float LPF_1st_1000Hz_10Hz[8] = {
N    0.0628f, 0.0000f, 0.0000f,   // b0, b1, b2
N    1.0000f, 0.9372f, 0.0000f,   // a0, a1, a2
N    1.0000f, 1.0000f              // gain0, gain1
N};
N//二阶贝塞尔低通滤波器（Bessel）
Nconst float LPF_Bessel_1000Hz_10Hz[8] = {
N    0.0065f, 0.0130f, 0.0065f,   // b0, b1, b2
N    1.0000f, -1.6548f, 0.6808f,   // a0, a1, a2
N    1.0000f, 1.0000f              // gain0, gain1
N};
N//高通滤波二阶巴特沃斯，截止频率=0.5Hz（抑制低于 0.5 Hz 的漂移，保留快速变化的谱峰）
Nconst float HPF_Spectrum_Coeff[8] = {
N    0.9878f, -1.9756f, 0.9878f,  // b0, b1, b2
N    1.0f, -1.9556f, 0.9565f,     // a0, a1, a2
N    1.0f, 1.0f                    // gain0, gain1
N};
Nconst float HPF_1000Hz[8] = {
N    0.9978f, -1.9956f, 0.9978f,   // b0, b1, b2
N    1.0f,    -1.9956f, 0.9956f,   // a0, a1, a2
N    1.0f,     1.0f                 // gain0, gain1
N};
N//带阻滤波 抑制 50 Hz 或 60 Hz 工频干扰，二阶巴特沃斯带阻，中心频率 50 Hz，品质因数 Q=10（带宽约 5 Hz）
Nconst float BSF_50Hz_Coeff[8] = {
N    0.9605f, -1.8095f, 0.9605f,   // b0, b1, b2
N    1.0f, -1.8095f, 0.9210f,      // a0, a1, a2
N    1.0f, 1.0f                     // gain0, gain1
N};
Nconst float BSF_1000Hz[8] = {
N    0.9848f, -1.8732f, 0.9848f,   // b0, b1, b2
N    1.0f,    -1.8732f, 0.9696f,   // a0, a1, a2
N    1.0f,     1.0f                 // gain0, gain1
N};
N
N
N
N
N
N
N//巴特沃兹算法
NIIR_BUTTERWORTH_DEF DATA_IIR_LPF_Par,DATA_IIR_HPF_Par,DATA_IIR_BSF_Par;
N
Nvoid IIR_Par_Init(unsigned char scan_step)
N{
N
N	if(scan_step < 5)
N	{
N		IIR_Butterworth_Coefficient_Init(LPF_100Hz_5Hz,&DATA_IIR_LPF_Par);	
N		IIR_Butterworth_Coefficient_Init(HPF_1000Hz,&DATA_IIR_HPF_Par);	
N		IIR_Butterworth_Coefficient_Init(BSF_1000Hz,&DATA_IIR_BSF_Par);	
N	}
N	else
N	{
N		IIR_Butterworth_Coefficient_Init(LPF_100Hz_5Hz,&DATA_IIR_LPF_Par);	
N		IIR_Butterworth_Coefficient_Init(HPF_Spectrum_Coeff,&DATA_IIR_HPF_Par);	
N		IIR_Butterworth_Coefficient_Init(BSF_50Hz_Coeff,&DATA_IIR_BSF_Par);	
N	}
N//		alpha = 0.25;
N//		_lpf_prev = 0;
N}
N/*
N低通 → 高通 → 带阻（避免先高通放大低频噪声后陷波效果变差）
Nfloat out1, out2, out3;
NIIR_Butterworth(raw_signal, &out1, &lpf);
NIIR_Butterworth(out1, &out2, &hpf);
NIIR_Butterworth(out2, &out3, &bsf);
N若扫描速度更快（如 100 Hz 采样率扫描 20 Hz 信号），将低通截止频率提高到 20~30 Hz。
N*/
Nvoid IIR_Butterworth_Coefficient_Init(const float temp[8],IIR_BUTTERWORTH_DEF* iir_butterworth_temp)
N{
N  iir_butterworth_temp->b0 = temp[0];
N  iir_butterworth_temp->b1 = temp[1];
N  iir_butterworth_temp->b2 = temp[2];
N  iir_butterworth_temp->a0 = temp[3];
N  iir_butterworth_temp->a1 = temp[4];
N  iir_butterworth_temp->a2 = temp[5];
N  iir_butterworth_temp->gain0 = temp[6];
N  iir_butterworth_temp->gain1 = temp[7];
N  iir_butterworth_temp->states0 = 0.0f;
N  iir_butterworth_temp->states1 = 0.0f;
N}
N/*
N核心算法
Ntemp = gain0 * in - a1 * states0 - a2 * states1;
Nout = (b0 * temp + b1 * states0 + b2 * states1) * gain1;
Nstates1 = states0;
Nstates0 = temp;
N*/
Nvoid IIR_Butterworth(float in,float* out,IIR_BUTTERWORTH_DEF* iir_butterworth_temp)
N{
N  float temp;
N  temp =(iir_butterworth_temp->gain0 * in
N         -iir_butterworth_temp->a1 * iir_butterworth_temp->states0)
N    -iir_butterworth_temp->a2 * iir_butterworth_temp->states1;
N  *out = ((iir_butterworth_temp->b0 * temp + iir_butterworth_temp->b1 * iir_butterworth_temp->states0) +
N          iir_butterworth_temp->b2 * iir_butterworth_temp->states1)*iir_butterworth_temp->gain1;
N  
N  iir_butterworth_temp->states1 = iir_butterworth_temp->states0;
N  iir_butterworth_temp->states0 = temp;
N}
N
N
Nvoid IIR_Butterworth_LPF(float in,float* out)
N{
N  float temp;
N	IIR_BUTTERWORTH_DEF* iir_butterworth_temp = &DATA_IIR_LPF_Par;
N	
N  temp =(iir_butterworth_temp->gain0 * in
N         -iir_butterworth_temp->a1 * iir_butterworth_temp->states0)
N    -iir_butterworth_temp->a2 * iir_butterworth_temp->states1;
N  *out = ((iir_butterworth_temp->b0 * temp + iir_butterworth_temp->b1 * iir_butterworth_temp->states0) +
N          iir_butterworth_temp->b2 * iir_butterworth_temp->states1)*iir_butterworth_temp->gain1;
N  
N  iir_butterworth_temp->states1 = iir_butterworth_temp->states0;
N  iir_butterworth_temp->states0 = temp;
N}
