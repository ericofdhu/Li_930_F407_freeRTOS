# ============================================================
# Li_930_F407_freeRTOS  .gitignore
# Keil MDK-ARM + STM32CubeMX + FreeRTOS
# 原则：源码与工程配置入库，编译产物与个人界面配置一律忽略
# ============================================================

# ------------------------------------------------------------
# 1. Keil MDK 编译输出目录（整个目录都是产物）
# ------------------------------------------------------------
MDK-ARM/Li_930_F407_freeRTOS/
MDK-ARM/Objects/
MDK-ARM/List/
MDK-ARM/Listings/
Objects/
Listings/
DebugConfig/

# ------------------------------------------------------------
# 2. Keil 编译中间件与产物（兜底，防止散落到别处）
# ------------------------------------------------------------
*.o
*.d
*.crf
*.dep
*.lnp
*.axf
*.fed
*.l2p
*.iex
*.map
*.lst
*.htm
*.build_log.htm
*.build_log.htm*
*.sct.bak

# ------------------------------------------------------------
# 3. Keil 个人环境配置（每台机器/每个用户不同，切勿入库）
#    uvprojx = 工程文件（入库）
#    uvoptx  = 工程选项（入库，团队共享调试配置）
#    uvguix  = 窗口布局（忽略，含用户名与绝对路径）
# ------------------------------------------------------------
*.uvguix.*
*.uvopt.bak
*.uvproj.bak
JLinkLog.txt
JLinkSettings.ini
*.log
*.log.lock
*.lock

# ------------------------------------------------------------
# 4. 压缩包与临时文件（别把 rar/备份塞进仓库）
# ------------------------------------------------------------
*.rar
*.zip
*.7z
*.bak
*~
*.tmp
*.swp

# ------------------------------------------------------------
# 5. 操作系统 / 编辑器
# ------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
.vs/
.idea/

# ------------------------------------------------------------
# 6. 保留：RTE 目录必须入库（RTE_Components.h 是工程依赖）
#    以及启动文件、链接脚本、分散加载文件
# ------------------------------------------------------------
!MDK-ARM/RTE/
!MDK-ARM/RTE/**/*
!startup_*.s
!*.scvd
